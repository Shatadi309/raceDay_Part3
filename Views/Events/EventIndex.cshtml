@model List<raceDay_Part3.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="events-management">

    <div class="events-heading">
        <div>
            <span class="events-label">ORGANIZER AREA</span>
            <h2>Manage Events</h2>
            <p>Create, update and manage your running events.</p>
        </div>

        <a asp-controller="Events"
           asp-action="Create"
           class="btn create-event-button">
            + Create New Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="events-empty">
            <h4>No Events Available</h4>
            <p>There are currently no events to display.</p>

            <a asp-controller="Events"
               asp-action="Create"
               class="btn create-event-button">
                Create Your First Event
            </a>
        </div>
    }
    else
    {
        <div class="events-table-card">

            <div class="events-table-heading">
                <h4>Event List</h4>
                <span>@Model.Count event(s)</span>
            </div>

            <div class="table-responsive">
                <table class="table events-table">

                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Description</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Entry Fee</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EventName</td>
                                <td>@item.EventDescription</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.Location</td>
                                <td>@item.EntryFee.ToString("C")</td>

                                <td>
                                    <div class="event-actions">

                                        <a asp-controller="Events"
                                           asp-action="Edit"
                                           asp-route-id="@item.EventID"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-controller="Events"
                                           asp-action="Delete"
                                           asp-route-id="@item.EventID"
                                           class="btn btn-danger btn-sm">
                                            Delete
                                        </a>

                                        <a asp-controller="Events"
                                           asp-action="Enrolments"
                                           asp-route-id="@item.EventID"
                                           class="btn btn-info btn-sm">
                                            Enrolments
                                        </a>

                                        <a asp-controller="Events"
                                           asp-action="Results"
                                           asp-route-id="@item.EventID"
                                           class="btn btn-success btn-sm">
                                            Results
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    }

</div>
