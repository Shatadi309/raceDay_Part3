@model List<raceDay_Part3.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-5">

    <h2 class="mb-4">Manage Events</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="mb-4">
        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Entry Fee</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.EventDescription</td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Location</td>
                            <td>@item.EntryFee.ToString("C")</td>

                            <td>
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Events"
                                   asp-action="Delete"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>
