@model raceDay_Part3.Models.EventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="event-form-page">

    <div class="event-form-card">

        <div class="event-form-heading">
            <span class="event-form-label">EVENT MANAGEMENT</span>
            <h2>Edit Event</h2>
            <p>Update the details of your event below.</p>
        </div>

        <form asp-controller="Events"
              asp-action="Edit"
              asp-route-id="@Model.EventID"
              method="post">

            <input type="hidden" asp-for="EventID" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="EventName" class="form-label">
                    Event Name
                </label>
                <input asp-for="EventName"
                       class="form-control"
                       placeholder="Enter event name" />
                <span asp-validation-for="EventName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EventDescription" class="form-label">
                    Event Description
                </label>
                <textarea asp-for="EventDescription"
                          class="form-control"
                          rows="3"
                          placeholder="Describe your event"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EventDate" class="form-label">
                    Event Date
                </label>
                <input asp-for="EventDate"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="EventDate"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">
                    Location
                </label>
                <input asp-for="Location"
                       class="form-control"
                       placeholder="Enter event location" />
                <span asp-validation-for="Location"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EntryFee" class="form-label">
                    Entry Fee
                </label>
                <input asp-for="EntryFee"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="0.00" />
                <span asp-validation-for="EntryFee"
                      class="text-danger"></span>
            </div>

            <div class="event-form-buttons">

                <button type="submit" class="event-save-button">
                    Update Event
                </button>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="event-cancel-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>