@model raceDay_Part3.Models.RecordResultViewModel

@{
    ViewData["Title"] = "Record Race Result";
}

<div class="container mt-4">
    <h2>Record Race Result</h2>

    <form asp-controller="Events"
          asp-action="RecordResult"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EnrolmentID" />
        <input type="hidden" asp-for="EventID" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Finishing Position
            </label>
            <input asp-for="Position" type="number" min="1" class="form-control" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time (HH:MM:SS)
            </label>
            <input asp-for="FinishTime"
                   type="text"
                   class="form-control"
                   placeholder="00:35:20"
                   value="00:00:00" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-controller="Events"
           asp-action="Enrolments"
           asp-route-id="@Model.EventID"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>