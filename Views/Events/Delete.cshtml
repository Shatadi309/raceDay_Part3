@model raceDay_Part3.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="delete-event-page">

    <div class="delete-event-card">

        <div class="delete-event-icon">
            !
        </div>

        <span class="delete-event-label">EVENT MANAGEMENT</span>

        <h2>Delete Event</h2>

        <p class="delete-event-warning">
            Are you sure you want to delete this event?
            This action cannot be undone.
        </p>

        <div class="delete-event-details">

            <div class="delete-detail-row">
                <strong>Event Name</strong>
                <span>@Model.EventName</span>
            </div>

            <div class="delete-detail-row">
                <strong>Description</strong>
                <span>@Model.EventDescription</span>
            </div>

            <div class="delete-detail-row">
                <strong>Date</strong>
                <span>@Model.EventDate.ToString("dd MMM yyyy")</span>
            </div>

            <div class="delete-detail-row">
                <strong>Location</strong>
                <span>@Model.Location</span>
            </div>

            <div class="delete-detail-row">
                <strong>Entry Fee</strong>
                <span>@Model.EntryFee.ToString("C")</span>
            </div>

        </div>

        <form asp-controller="Events"
              asp-action="DeleteConfirmed"
              asp-route-id="@Model.EventID"
              method="post">

            <div class="delete-event-buttons">

                <button type="submit" class="delete-confirm-button">
                    Yes, Delete Event
                </button>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="delete-cancel-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
