@model raceDay_Part3.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="text-danger mb-3">Delete Event</h2>

        <p>Are you sure you want to delete this event?</p>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">Event Name</dt>
            <dd class="col-sm-9">@Model.EventName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.EventDescription</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">
                @Model.EventDate.ToString("dd MMM yyyy")
            </dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Entry Fee</dt>
            <dd class="col-sm-9">@Model.EntryFee.ToString("C")</dd>

        </dl>

        <form asp-controller="Events"
              asp-action="DeleteConfirmed"
              asp-route-id="@Model.EventID"
              method="post">

            <button type="submit" class="btn btn-danger">
                Yes, Delete Event
            </button>

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>
