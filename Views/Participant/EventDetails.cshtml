@model raceDay_Part3.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <h2 class="mb-3">Event Details</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h3>@Model.EventName</h3>
            <p>@Model.EventDescription</p>
            <hr />

            <p><strong>Event Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Entry Fee:</strong> @Model.EntryFee.ToString("C")</p>

            <hr />

            <h5>Enrol in this Event</h5>

            @if (Model.Categories != null && Model.Categories.Any())
            {
                <form asp-controller="Participant"
                      asp-action="Enrol"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="eventID" value="@Model.EventID" />
                    <input type="hidden" name="paymentAmount" value="@Model.EntryFee" />

                    <div class="mb-3">
                        <label for="categoryID" class="form-label">
                            Select your category
                        </label>

                        <select name="categoryID"
                                id="categoryID"
                                class="form-select"
                                required>

                            <option value="">Choose a category</option>

                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.EventCategoryID">
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Enrol in Event
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    No categories are currently available for enrolment.
                </div>
            }

            <a asp-controller="Participant"
               asp-action="Events"
               class="btn btn-secondary mt-3">
                Back to Events
            </a>
        </div>
    </div>
</div>
