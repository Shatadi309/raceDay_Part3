@model raceDay_Part3.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="participant-details-page">

    <div class="participant-details-card">

        <span class="participant-page-label">EVENT INFORMATION</span>

        <h2>@Model.EventName</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <p class="participant-details-description">
            @Model.EventDescription
        </p>

        <div class="participant-event-information">
            <p><strong>Event Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Entry Fee:</strong> @Model.EntryFee.ToString("C")</p>
        </div>

        <div class="participant-enrolment-section">

            <h5>Enrol in this Event</h5>
            <p>Select the category you would like to participate in.</p>

            @if (Model.Categories != null && Model.Categories.Any())
            {
                <form asp-controller="Participant"
                      asp-action="Enrol"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="eventID" value="@Model.EventID" />
                    <input type="hidden" name="paymentAmount" value="@Model.EntryFee" />

                    <div class="mb-3">
                        <label for="categoryID" class="form-label">
                            Select your category
                        </label>

                        <select name="categoryID"
                                id="categoryID"
                                class="form-select"
                                required>

                            <option value="">Choose a category</option>

                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.EventCategoryID">
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="participant-enrol-button">
                        Enrol in Event
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    No categories are currently available for enrolment.
                </div>
            }

        </div>

        <a asp-controller="Participant"
           asp-action="Events"
           class="participant-back-button">
            Back to Events
        </a>

    </div>

</div>
