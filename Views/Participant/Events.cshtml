@model List<raceDay_Part3.Models.EventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<div class="participant-events-page">

    <div class="participant-events-heading">
        <span class="participant-page-label">DISCOVER RACEDAY</span>
        <h2>Available Events</h2>
        <p>Browse upcoming events and choose one that you would like to participate in.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="participant-empty">
            <h4>No Events Available</h4>
            <p>No events are currently available.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="participant-event-card">

                        <div class="participant-event-card-top"></div>

                        <div class="participant-event-card-body">
                            <h5>@item.EventName</h5>

                            <p class="participant-event-description">
                                @item.EventDescription
                            </p>

                            <div class="participant-event-detail">
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </div>

                            <div class="participant-event-detail">
                                <strong>Location:</strong>
                                @item.Location
                            </div>

                            <div class="participant-event-detail">
                                <strong>Entry Fee:</strong>
                                @item.EntryFee.ToString("C")
                            </div>

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@item.EventID"
                               class="participant-event-button">
                                View Details
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
