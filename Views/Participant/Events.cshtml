@model List<raceDay_Part3.Models.EventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<div class="container mt-4">
    <h2 class="mb-3">Available Events</h2>

    <p class="text-muted">
        Browse upcoming events and choose one that you would like to participate in.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@item.EventName</h5>

                            <p class="card-text">
                                @item.EventDescription
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                @item.EntryFee.ToString("C")
                            </p>

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@item.EventID"
                               class="btn btn-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
