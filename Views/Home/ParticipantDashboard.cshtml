@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h2>Participant Dashboard</h2>

        <p>Welcome, @Context.Session.GetString("FullName")!</p>

        <p>
            This area is for participants to view available events,
            manage their enrolments and check their results.
        </p>

        <hr />

        <h5>Participant Activities</h5>

        <p>Browse events and find one you would like to participate in.</p>

        <a asp-controller="Participant"
           asp-action="Events"
           class="btn btn-primary">
            View Available Events
        </a>

        <a asp-controller="Participant"
           asp-action="MyEnrolments"
           class="btn btn-success">
            My Enrolments
        </a>
    </div>
</div>
