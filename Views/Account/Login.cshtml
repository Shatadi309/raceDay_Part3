@model raceDay_Part3.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="login-heading">
            <span class="login-label">WELCOME BACK</span>
            <h2>Login to RaceDay</h2>
            <p>Sign in to continue your running journey.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <form asp-action="Login" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger login-validation"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter your email address" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">
                    Password
                </label>
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn login-button w-100">
                Login
            </button>

        </form>

        <div class="login-register">
            <p>
                Don't have an account?
                <a asp-action="Register">Register here</a>
            </p>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
