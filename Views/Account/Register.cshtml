@model raceDay_Part3.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-page">

    <div class="register-card">

        <div class="register-heading">
            <span class="register-label">JOIN RACEDAY</span>
            <h2>Create an Account</h2>
            <p>Get started with your running journey today.</p>
        </div>

        <form asp-action="Register" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger register-validation"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">
                    Full Name
                </label>
                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Enter your full name" />
                <span asp-validation-for="FullName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter your email address" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">
                    Phone Number
                </label>
                <input asp-for="PhoneNumber"
                       class="form-control"
                       placeholder="Enter your phone number" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Password
                </label>
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Create a password" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label">
                    Account Type
                </label>

                <select asp-for="Role" class="form-select">
                    <option value="Participant">Participant</option>
                    <option value="Organizer">Organizer</option>
                </select>
            </div>

            <button type="submit"
                    class="btn register-button w-100">
                Create Account
            </button>

        </form>

        <div class="register-login">
            <p>
                Already registered?
                <a asp-action="Login">Log in here</a>
            </p>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
