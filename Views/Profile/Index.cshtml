@model raceDay_Part3.Models.ProfileImageViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">

    <div class="profile-card">

        <div class="profile-heading">
            <span class="profile-label">YOUR ACCOUNT</span>
            <h2>My Profile</h2>
            <p>Manage your profile picture and personal appearance.</p>
        </div>

        <div class="profile-picture-section">

            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath"
                     alt="Profile Picture"
                     class="profile-picture" />
            }
            else
            {
                <div class="profile-placeholder">
                    <span>R</span>
                </div>

                <p class="profile-empty-message">
                    No profile picture uploaded yet.
                </p>
            }

            <h4>Profile Picture</h4>
            <p>Choose a picture to personalise your RaceDay account.</p>

        </div>

        <hr />

        <form asp-controller="Profile"
              asp-action="Upload"
              method="post"
              enctype="multipart/form-data">

            <div class="mb-4">

                <label asp-for="ProfileImage" class="form-label">
                    Select Profile Picture
                </label>

                <input asp-for="ProfileImage"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png" />

                <span asp-validation-for="ProfileImage"
                      class="text-danger"></span>

                <small class="profile-hint">
                    Accepted formats: JPG, JPEG and PNG.
                </small>

            </div>

            <button type="submit" class="btn profile-upload-button">
                Upload Picture
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
